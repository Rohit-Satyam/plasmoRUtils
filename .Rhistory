c("OG7_0008348", "OG7_0003896")
)
getOrthoMCLPreviousGroups <- function(group_names,
customField = "previousGroups") {
stopifnot(length(group_names) > 0)
base_url <- paste0(
"https://orthomcl.org/orthomcl/",
"service/record-types/group/searches/GroupsByNameList/reports/tableTabular"
)
reportConfig <- jsonlite::toJSON(
list(
tables = list(customField),
includeHeader = TRUE,
attachmentType = "plain"
),
auto_unbox = TRUE
)
resp <- httr2::request(base_url) |>
httr2::req_url_query(
group_names = paste(group_names, collapse = "\n"),
reportConfig = reportConfig
) |>
httr2::req_error(is_error = function(resp) FALSE) |>
httr2::req_perform()
txt <- httr2::resp_body_string(resp)
if (httr2::resp_status(resp) >= 400) {
stop(
"OrthoMCL request failed with HTTP ",
httr2::resp_status(resp),
"\n\nServer response:\n",
txt,
call. = FALSE
)
}
readr::read_tsv(
I(txt),
progress = FALSE,
show_col_types = FALSE
)
}
