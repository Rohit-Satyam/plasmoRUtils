getOrthoMCLPreviousGroups <- function(group_names,
customField = "previousGroups",
parse = TRUE) {
stopifnot(length(group_names) > 0)
url <- paste0(
"https://orthomcl.org/orthomcl/",
"service/record-types/group/searches/GroupsByNameList/reports/tableTabular"
)
payload <- list(
searchConfig = list(
parameters = list(
# OrthoMCL accepts comma- or newline-separated group IDs
group_names = paste(group_names, collapse = "\n")
),
wdkWeight = 10
),
reportConfig = list(
tables = list(customField),
includeHeader = TRUE,
attachmentType = "plain"
)
)
resp <- httr2::request(url) |>
httr2::req_headers(
`Content-Type` = "application/json",
Accept = "text/plain"
) |>
httr2::req_body_json(payload, auto_unbox = TRUE) |>
httr2::req_perform()
txt <- httr2::resp_body_string(resp)
if (!parse) return(txt)
readr::read_tsv(
I(txt),
progress = FALSE,
show_col_types = FALSE
)
}
library(httr2)
